ror: ${(e as Error).message}`; }\n55\t    } else { output = `Unknown tool: ${b.name}`; }\n56\t\n57\t    if (opts?.updateStats) {\n58\t      const summary = tool?.getToolUseSummary?.(b.input || {}) || b.name!;\n59\t      opts.updateStats(b.name!, summary, output);\n60\t    }\n61\t    return { name: b.name!, id: b.id!, input: b.input || {}, output };\n62\t  }));\n63\t\n64\t  // 合并 + 显示（主Agent 才需要）\n65\t  if (opts?.onProgress) {\n66\t    opts.onProgress({ type: 'tool_display', calls: this.mergeToolCalls(calls) });\n67\t  }\n68\t\n69\t  // 格式化结果 + 注入消息\n70\t  for (const c of calls) {\n71\t    const tr = this.provider.formatToolResult(c.id, c.output);\n72\t    if (this.provider.name === 'openai') {\n73\t      this.sessionMessages.push(tr as ChatMessage);\n74\t    } else {\n75\t      toolResults.push(tr);\n76\t    }\n77\t  }\n78\t  if (this.provider.name !== 'openai') {\n79\t    this.sessionMessages.push({ role: 'user', content: toolResults });\n80\t  }\n81\t}\n82\t```\n83\t\n84\t## 四、run() 变化\n85\t\n86\t之前 ~30 行工具执行代码 → 变成一行：\n87\t\n88\t```typescript\n89\tawait this.executeToolCalls(toolUses, { onProgress });\n90\t```\n91\t\n92\t## 五、runSubAgent() 变化\n93\t\n94\t```typescript\n95\tawait this.executeToolCalls(toolUses, {\n96\t  updateStats: (name, summary, output) => {\n97\t    if (task?.agentLoop) {\n98\t      task.agentLoop.lastActivity = `${name}(${summary})`;\n99\t      task.agentLoop.lastOutput = output.slice(0, 200);\n100\t    }\n101\t  },\n102\t});\n103\t```\n104\t\n105\t## 六、验证\n106\t\n107\t| # | 场景 | 期望 |\n108\t|---|------|------|\n109\t| 1 | 主 Agent 调工具 → 终端显示 | 工具名+摘要正确显示 |\n110\t| 2 | 子 Agent 调工具 → Terminal 静默 | 不显示，但 agentLoop 统计更新 |\n111\t| 3 | 工具执行异常 | 错误信息正常返回，不崩 |\n112\t| 4 | 合并显示（Read ×4） | 合并逻辑不变 |\n113\t| 5 | 编译 | 零错误 |\n114\t\n115\t## 七、不做的事\n116\t\n117\t- 不引入 AgentContext\n118\t- 不拆 Stage 文件\n119\t- 不改引擎的外部接口（run() 签名不变）\n120\t- 目标：一个私有方法，消除重复，验证解耦可行性\n121\t"
